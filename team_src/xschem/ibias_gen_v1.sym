v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -70 -6 0 0 0.3 0.3 {}
T {@name} 135 -92 0 0 0.2 0.2 {}
P 4 5 -130 -80 130 -80 130 80 -130 80 -130 -80 {}
B 5 -152.5 -2.5 -147.5 2.5 {name=IBIAS dir=in}
L 4 -150 0 -130 0 {}
T {IBIAS} -125 -4 0 0 0.2 0.2 {}
B 5 147.5 -42.5 152.5 -37.5 {name=VGP dir=inout}
L 4 130 -40 150 -40 {}
T {VGP} 125 -44 0 1 0.2 0.2 {}
B 5 147.5 -2.5 152.5 2.5 {name=VGN dir=inout}
L 4 130 0 150 0 {}
T {VGN} 125 -4 0 1 0.2 0.2 {}
B 5 147.5 37.5 152.5 42.5 {name=IB_DIV2 dir=inout}
L 4 130 40 150 40 {}
T {IB_DIV2} 125 36 0 1 0.2 0.2 {}
B 5 -2.5 -102.5 2.5 -97.5 {name=VDD dir=inout}
L 4 0 -100 0 -80 {}
T {VDD} 4 -94 0 0 0.2 0.2 {}
B 5 -2.5 97.5 2.5 102.5 {name=VSS dir=inout}
L 4 0 80 0 100 {}
T {VSS} 4 88 0 0 0.2 0.2 {}

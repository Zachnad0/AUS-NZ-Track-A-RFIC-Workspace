v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -60 -170 0 0 0.3 0.3 {}
T {@name} 40 164 0 0 0.2 0.2 {}
P 4 5 -100 -160 100 -160 100 160 -100 160 -100 -160 {}
B 5 -122.5 -122.5 -117.5 -117.5 {name=UP dir=in}
L 4 -120 -120 -100 -120 {}
T {UP} -95 -126 0 0 0.2 0.2 {}
B 5 -122.5 -82.5 -117.5 -77.5 {name=DOWN dir=in}
L 4 -120 -80 -100 -80 {}
T {DOWN} -95 -86 0 0 0.2 0.2 {}
B 5 -122.5 -42.5 -117.5 -37.5 {name=CP_OUT dir=out}
L 4 -120 -40 -100 -40 {}
T {CP_OUT} -95 -46 0 0 0.2 0.2 {}
B 5 -122.5 -2.5 -117.5 2.5 {name=VDD dir=inout}
L 4 -120 0 -100 0 {}
T {VDD} -95 -6 0 0 0.2 0.2 {}
B 5 -122.5 37.5 -117.5 42.5 {name=VSS dir=inout}
L 4 -120 40 -100 40 {}
T {VSS} -95 34 0 0 0.2 0.2 {}
B 5 -122.5 77.5 -117.5 82.5 {name=VGP dir=in}
L 4 -120 80 -100 80 {}
T {VGP} -95 74 0 0 0.2 0.2 {}
B 5 -122.5 117.5 -117.5 122.5 {name=VGN dir=in}
L 4 -120 120 -100 120 {}
T {VGN} -95 114 0 0 0.2 0.2 {}
